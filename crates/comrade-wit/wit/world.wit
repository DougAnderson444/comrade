package comrade:core;

interface context {
    /// The context 
    resource context {
        /// Constructor for the resource.
        constructor();

        /// Check the signature of the given key str
        check-signature: func(key: string, msg: string) -> bool;

        /// Check the preimage of the given key str 
        check-preimage: func(key: string) -> bool;

        check-eq: func(key: string) -> bool;
        check-fail: func(err: string) -> bool;
        fail: func(err: string) -> bool;
        succeed: func() -> bool;
        push: func(key: string) -> bool;
        branch: func(key: string) -> bool;
    }
}

interface wacc {
    use pairs.{value};

    resource constructs {

        /// Constructor for the resource.
        constructor();

        /// Set the unlock script 
        try-unlock: func(script: string) -> result<_, string>;

        /// Tries a lock script 
        try-lock: func(lock: string) -> result<option<value>, string>;
    }
}

interface vm {
    use pairs.{value};
    use context.{context};

    /// The engine that will load and run the scripts
    resource engine {

        /// Constructor for the resource.
        constructor(context: context);

        /// Set the unlock script 
        load: func(script: string) -> result<_, string>;

        /// Tries to run a loaded script. Either Succeeds or Fails to run.
        run: func() -> result<bool, string>;
    }
}

interface host {
    /// Logs some output from the guest component.
    log: func(message: string);

    /// Get a random byte from the host system
    random-byte: func() -> u8;
}

interface pairs {

  /// Returns the value of the resource. 
  put: func(choice: either, key: string, value: value) -> value;

  /// Returns the value of the resource. 
  /// Get a value from the given key, if it exists.
  /// Returns some value or None.
  get: func(choice: either, key: string) -> option<value>;

  /// Either current or proposed 
  enum either {
    /// The current kv pairs
    current,

    /// The proposed kv pairs 
    proposed
  }

  /// A binary value and associated hint 
  record binary {
    /// The binary value
    value: list<u8>,

    /// A hint for the binary value
    hint: string
  }

  /// A string value and associated hint 
  record str {
    /// The string value
    value: string,

    /// A hint for the string value
    hint: string
  }

  /// A variant representing the different types of values that can be stored.
  variant value {
    /// A binary value 
    binary(binary),

    /// A string value 
    str(str),

    /// Success value 
    success(u32),

    /// Failure value 
    failure(string)
  }

}

/// An example world for the component to target.
world example {
    
    import host;
    import pairs;

    /// The engine that will load and run the scripts
    import vm;
    export context;

    export wacc;
}
